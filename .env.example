APP_ENV=development
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
WEB_BIND_HOST=127.0.0.1
WEB_PORT=5173
ALLOWED_HOSTS=127.0.0.1,localhost
COOKIE_SECURE=false
DATABASE_URL=postgresql+psycopg://hub:REPLACE_WITH_SECRET@db:5432/wechat_hub
POSTGRES_DB=wechat_hub
POSTGRES_USER=hub
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_SECRET
DATA_ROOT=/var/lib/wechat-hub
IMPORT_MAX_BYTES=1073741824
UPLOAD_MAX_FILES=5000
DEFAULT_TIMEZONE=Asia/Shanghai
ENABLE_OCR=false
ENABLE_ASR=false
ENABLE_EMBEDDINGS=false
ENABLE_LLM=false
ENABLE_ODOO=false
ENABLE_ODOO_WRITES=false
ALLOW_EXTERNAL_AI=false
ENABLE_OBJECT_STORAGE=false
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
LOG_LEVEL=INFO
# ODOO_URL=
# ODOO_USERNAME=
# ODOO_DATABASE=
# ODOO_API_KEY=
